{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "avatar",
  "description": "the one avatar window (served by the local server): it may ask the shell to bring the app back",
  "windows": [
    "avatar"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*",
      "http://localhost:*/*"
    ]
  },
  "permissions": [
    "core:default"
  ]
}