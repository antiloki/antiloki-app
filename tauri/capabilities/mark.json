{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mark",
  "description": "the corner mark, a page of the local server: move, size and hide its own window, and bring the main window back. Nothing else.",
  "windows": ["avatar"],
  "remote": { "urls": ["http://localhost:*"] },
  "permissions": [
    "core:window:allow-start-dragging", "core:window:allow-hide", "core:window:allow-set-size", "core:window:allow-set-position", "core:window:allow-outer-position", "core:window:allow-outer-size", "core:window:allow-scale-factor",
    "core:window:allow-get-all-windows", "core:window:allow-show", "core:window:allow-unminimize", "core:window:allow-set-focus"
  ]
}
